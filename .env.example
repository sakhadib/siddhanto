# Local environment. Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.

# Required. OpenRouter key, used to call the JEV decision model.
OPENROUTER_API_KEY=

# Required for response ratings to work. At least 16 chars; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs the receipt that binds a rating to a decision. Changing it invalidates
# every receipt issued under the old value, so ratings in flight will be
# rejected — ratings already written are unaffected.
# Without it, /api/decide still works, it just returns no receipt and the
# rating widget never appears.
RATING_SECRET=

# Optional. Salt for the one-way IP hash. Without it the code falls back to a
# hardcoded development salt, which makes the hashes guessable — set this in
# any real deployment.
IP_HASH_SALT=
